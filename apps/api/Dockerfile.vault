# The vault (src/vault-main.ts): the only process that holds KEYS_MASTER_SECRET and the sponsor key. Same package and lockfile as the api,
# built from apps/api like the api image; it runs no isolate pool, no model and no tool.
FROM oven/bun:1.3.11 AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY libs ./libs
RUN bun install --frozen-lockfile --production

FROM oven/bun:1.3.11
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src
# Drops the admin credentials the servel infra link injects before the process starts (see entrypoint.sh).
COPY --chmod=755 entrypoint.sh ./entrypoint.sh
USER bun
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD bun -e "const r = await fetch('http://127.0.0.1:8081/health'); process.exit(r.ok ? 0 : 1)"
ENTRYPOINT ["/app/entrypoint.sh", "vault"]
CMD ["bun", "run", "src/vault-main.ts"]
